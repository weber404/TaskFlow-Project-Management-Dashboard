# ==============================================================================
# TaskFlow Environment Variables Configuration
# ==============================================================================

# Neon Hosted PostgreSQL Database Connection URL
# Replace USER, PASSWORD, HOST, and DATABASE with your actual Neon project credentials.
# Note: For Neon, ensure '?sslmode=require' is appended.
# Example format: postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Next.js Application URL (Optional, defaults to localhost:3000 in dev)
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
